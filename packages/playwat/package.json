    "babel-loader": "^9.2.1",
    "cross-env": "^7.0.3",
    "css-loader": "^6.10.0",
    "examples-plugin": "workspace:*",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.7",
    "monaco-editor-webpack-plugin": "^7.1.0",
